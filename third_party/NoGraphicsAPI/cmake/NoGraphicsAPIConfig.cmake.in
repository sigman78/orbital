@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Vulkan 1.4.357)
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" OR "@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
    find_dependency(SDL2 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NoGraphicsAPITargets.cmake")

check_required_components(NoGraphicsAPI)
